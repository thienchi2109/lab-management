{
  "name": "lab-kit-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "react-doctor": "npm exec --yes --package react-doctor@latest -- react-doctor . --no-telemetry --fail-on error",
    "react-doctor:verbose": "npm exec --yes --package react-doctor@latest -- react-doctor . --verbose --no-telemetry --fail-on error",
    "react-doctor:staged": "npm exec --yes --package react-doctor@latest -- react-doctor . --staged --no-telemetry --fail-on error",
    "react-doctor:diff": "npm exec --yes --package react-doctor@latest -- react-doctor . --diff --no-telemetry --fail-on error",
    "docstring:check": "node scripts/verify-docstrings.mjs",
    "test": "vitest run",
    "test:docstring-gate": "node --test scripts/docstring-gate-lib.node-test.mjs",
    "test:react-doctor-cleanup": "node scripts/verify-react-doctor-cleanup.mjs",
    "quality": "bun run typecheck && bun run lint:strict && bun run format:check && bun run react-doctor && bun run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.2.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
